[To Disk]
; Place SpotifyHistory.ini beside version.dll. Settings also appear in To Disk.
Downloads=0
; Set Menu=0 before starting Spotify to disable native menu integration.
Menu=1
; Empty uses Windows' Music known folder plus \Spotify, including redirects.
Save Location=
Ogg=1
; Captures native FLAC when Spotify supplies lossless audio; no conversion.
Flac=1

; Optional enrichment from existing client state/caches only; no requests; set 0 to disable its CEF hooks.
Metadata=1
; Single activity log in Save Location; capped at 5 MiB.
Log=1
; Opt-in diagnostic detail uses the same capped log.
DebugLog=0

[History]
; Compressed track buffers stay in RAM. Larger tracks are discarded at this limit.
; Native tagging temporarily needs another buffer for the completed track.
MaxBufferedMiB=64
; 0 means ongoing history. 3 disables Downloads after three published tracks.
StopAfter=0
